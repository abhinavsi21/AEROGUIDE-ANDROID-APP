{
  "appId": "com.cloudcrew.aeroguide",
  "appName": "AeroGuide",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "aeroguide"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#071426",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#38bdf8",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#071426"
    }
  }
}
